# Copy to .env for local development. Never commit .env.
# In production these values come from a secret manager / the deployment platform.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://tubo:tubo_dev_password@localhost:5433/tubo
DB_POOL_MAX=10

# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# External (mock) government API
GOV_API_BASE_URL=http://localhost:4001
GOV_API_KEY=dev-gov-api-key
GOV_TIMEOUT_MS=5000
GOV_RATE_LIMIT_PER_SEC=20

# Worker. Retry values below are shortened so failures are quick to demo;
# production defaults (in src/config.js) are 14 attempts, 5s base, 10min cap (35-70 min of retrying).
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
MAX_AUTO_ATTEMPTS=4
BACKOFF_BASE_MS=2000
BACKOFF_MAX_MS=600000
# Probability (0..1) that the worker kills itself right after the government API accepted
# an invoice, before saving SUBMITTED. Used to demo the Part I crash scenario.
CHAOS_CRASH_AFTER_SUBMIT_RATE=0

# Mock government API behaviour
MOCK_GOV_PORT=4001
MOCK_GOV_UNAVAILABLE_RATE=0.2
MOCK_GOV_REJECT_RATE=0.05
MOCK_GOV_TIMEOUT_RATE=0.1
MOCK_GOV_TIMEOUT_DELAY_MS=20000
MOCK_GOV_MAX_RPS=100
